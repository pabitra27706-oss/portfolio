@charset "utf-8";

html, body { max-width: 100%; }

body { font-family: "Trebuchet MS", Helvetica, Arial, sans-serif; font-size: 13pt; }

header { z-index: 100; }

#container { z-index: 0; }

#background-canvas { z-index: 1; }

#tiles-canvas { z-index: 10; }

#tiles-canvas-anim { z-index: 11; }

#bridge-canvas { z-index: 20; }

#bridge-canvas-anim { z-index: 21; }

#decorative-objects-canvas { z-index: 30; }

#decorative-objects-canvas-anim { z-index: 31; }

#obstacles-canvas { z-index: 40; }

#obstacles-canvas-anim { z-index: 41; }

#goal-canvas { z-index: 50; }

#goal-canvas-anim { z-index: 52; }

#objects-canvas { z-index: 60; }

#objects-canvas-anim { z-index: 61; }

#trace-canvas { z-index: 70; }

#pushables-canvas { z-index: 80; }

#pushables-canvas-anim { z-index: 81; }

#wall-canvas { z-index: 89; }

#robot-canvas { z-index: 90; }

#robot-anim-canvas { z-index: 91; }

#tooltip { z-index: 100; }

#Reeborg-writes { z-index: 210; }

#Reeborg-success { z-index: 211; }

#Reeborg-failure { z-index: 211; }

#World-info { z-index: 205; }

#world-panel { z-index: 120; }

#editor-panel.active { z-index: 200; }

#keyboard-buttons ul li { z-index: 230; }

button:focus, a:focus { outline: none; }

button[disabled] { background: rgb(238, 238, 238); }

header { position: absolute; top: 0px; left: 0px; width: 100%; min-width: 800px; }

header form { font-size: 0.8em; font-weight: bold; position: relative; float: left; margin-left: 5px; padding: 8px 5px 5px; color: white; border-left: 1px solid rgba(255, 255, 255, 0.3); }

h1 { font-size: 1.7em; color: rgb(34, 68, 136); }

h2 { font-size: 1.3em; color: rgb(34, 68, 136); }

h3 { font-size: 1.1em; color: rgb(34, 68, 136); }

canvas { position: absolute; top: 5px; border: 1px solid green; }

.edit-canvas { position: relative; }

.align-middle { vertical-align: middle; }

#tooltip { background-color: white; border: 1px solid blue; position: absolute; left: -200px; top: 100px; }

#py-console { position: absolute; top: 100px; left: 650px; font-weight: bold; }

code { font-family: "Roboto Mono", "Bitstream Vera Sans Mono", "DejaVu Sans Mono", Monaco, Courier, monospace; font-weight: bold; color: green; }

pre.error { color: darkred; }

nav { text-align: center; }

nav a { display: inline-block; margin: 0px; }

nav a:last-child { border-radius: 0px 20px 20px 0px; }

nav a:first-child { border-radius: 20px 0px 0px 20px; }

#highlight, #watch-variables-btn { height: 40px; }

#highlight:disabled, #watch-variables-btn:disabled, #open-solution-btn:disabled, #save-solution-btn:disabled { display: none !important; }

button { font-weight: bold; position: relative; height: 37px; margin: 0px; background-color: rgb(17, 34, 68); }

a.left-link, a.right-link, button, a.fake-button { font-size: 12pt; padding: 5px; text-decoration: none; border-width: 0px 1px; border-top-style: initial; border-top-color: initial; border-right-style: solid; border-right-color: rgba(0, 0, 0, 0.1); border-bottom-style: initial; border-bottom-color: initial; border-left-style: solid; border-left-color: rgba(255, 255, 255, 0.3); color: white !important; }

p button { float: none; }

a[href^="http"] { padding-right: 16px; background: url("../images/external_link.png") right center no-repeat transparent; }

#select-world { margin: 10px; }

.select-menu { background-color: rgb(153, 255, 255); }

.select-local-storage { background-color: rgb(255, 255, 153); }

.select-mixed { background-color: beige; }

.filename:focus { border: 2px solid blue; }

.filename:hover { border: 2px solid green; }

fieldset { display: inline-block; color: rgb(18, 50, 100); border: solid rgb(18, 50, 100); border-radius: 10px; }

fieldset label { display: block; }

fieldset label input { float: right; }

fieldset label input[type="checkbox"] { float: left; }

legend { color: rgb(18, 50, 100); }

#resize { float: right; }

.active-element { background-color: rgb(17, 34, 68); }

button.solution-button { border: 1px solid rgb(17, 34, 68); background-color: white; }

.automatic-description a.fake-button, .ui-tabs .ui-tabs-nav li, .blue-gradient, .left-link, .right-link, .ui-widget-header { background-color: rgb(18, 50, 100); background-image: -webkit-linear-gradient(top, rgb(45, 90, 180) 20%, rgb(30, 60, 120) 60%, rgb(18, 50, 100) 80%); }

input.blue-gradient { font-size: 12pt; font-weight: bold; position: relative; height: 37px; margin: 0px; background-color: rgb(17, 34, 68); color: white; }

button.blue-gradient { font-size: 12pt; }

.ui-tabs .ui-tabs-nav li, .ui-tabs .ui-tabs-nav li.ui-tabs-active:hover { top: 3px; border-bottom: 3px solid rgb(117, 161, 16); }

.ui-tabs .ui-tabs-nav li:first-child { margin-left: 30px; }

.ui-tabs .ui-tabs-nav li a { color: white; font-size: 12pt; }

.ui-tabs .ui-tabs-nav li.ui-tabs-active { top: 3px; border-bottom: 3px solid rgb(17, 34, 68); background-color: rgb(17, 34, 68); background-image: none; }

.ui-tabs .ui-tabs-nav li:hover, button:hover:enabled, a.fake-button:hover, .green-gradient, a.left-link:hover, a.right-link:hover, input.blue-gradient:hover { background-color: rgb(117, 161, 16); background-image: -webkit-linear-gradient(top, rgb(190, 255, 127), rgb(150, 196, 35) 50%, rgb(117, 161, 16)); }

.alert .ui-widget-header { background-color: rgb(200, 0, 0); border-bottom: 1px solid rgb(200, 0, 0); background-image: none; }

.concludes .ui-widget-header { background-color: rgb(117, 161, 16); background-image: -webkit-linear-gradient(top, rgb(190, 255, 127), rgb(150, 196, 35) 50%, rgb(117, 161, 16)); }

.proclaims .ui-widget-header { background-color: rgb(102, 51, 153); border-bottom: 1px solid rgb(102, 51, 153); background-image: none; }

.watches .ui-widget-header { background-color: rgb(62, 126, 16); border-bottom: 1px solid rgb(62, 126, 16); background-image: none; }

.warning { color: red; text-shadow: black 1px 1px 1px; }

.green-border { border-bottom: 4px solid rgb(117, 161, 16); }

.ui-widget-header { border-bottom: 3px solid rgb(117, 161, 16); }

.success { list-style: none; color: green; }

li.success::after, p.success::after { content: url("../images/ok.png"); }

.failure { list-style: none; color: rgb(200, 0, 0); }

li.failure::after, p.failure::after { content: url("../images/not_ok.png"); }

.CodeMirror { font-size: 13px; width: 99.9%; height: 100%; border: 1px solid black; }

.cm-s-reeborg-readonly, .cm-s-reeborg-dark { font-size: 13pt; line-height: 1.4em; }

.cm-s-reeborg-readonly.CodeMirror, .cm-s-reeborg-dark.CodeMirror { color: white; border: 0px; background: rgb(17, 34, 68); }

.cm-s-reeborg-readonly .CodeMirror-gutters, .cm-s-reeborg-dark .CodeMirror-gutters { border-right: 3px solid rgb(117, 161, 16); background: rgb(34, 68, 136); }

.cm-s-reeborg-readonly.CodeMirror { background-image: linear-gradient(45deg, rgba(10, 10, 10, 0.4) 25%, transparent 25%, transparent 50%, rgba(10, 10, 10, 0.4) 50%, rgba(10, 10, 10, 0.4) 75%, transparent 75%, transparent); background-size: 50px 50px; }

.cm-s-reeborg-readonly .CodeMirror-linenumber, .cm-s-reeborg-dark .CodeMirror-linenumber { font-size: 9pt; color: white; }

.cm-s-reeborg-readonly .CodeMirror-cursor { display: none; }

.cm-s-reeborg-dark .CodeMirror-cursor { border-left: 2px solid white !important; }

.cm-s-reeborg-readonly .cm-comment, .cm-s-reeborg-dark .cm-comment { font-style: italic; line-height: 1em; color: rgb(153, 204, 153); }

.cm-s-reeborg-readonly .cm-atom, .cm-s-reeborg-dark .cm-atom { color: rgb(244, 194, 11); }

.cm-s-reeborg-readonly .cm-number, .cm-s-reeborg-readonly .cm-attribute, .cm-s-reeborg-dark .cm-number, .cm-s-reeborg-dark .cm-attribute { color: rgb(204, 238, 255); }

.cm-s-reeborg-readonly .cm-keyword, .cm-s-reeborg-readonly .cm-tag, .cm-s-reeborg-dark .cm-keyword, .cm-s-reeborg-dark .cm-tag { color: rgb(251, 222, 45); }

.cm-s-reeborg-readonly .cm-operator, .cm-s-reeborg-dark .cm-operator { color: rgb(251, 222, 45); }

.cm-s-reeborg-readonly .cm-string, .cm-s-reeborg-dark .cm-string { color: rgb(240, 128, 71); }

.cm-s-reeborg-readonly .cm-variable-2, .cm-s-reeborg-dark .cm-variable-2 { color: rgb(153, 255, 153); }

.cm-s-reeborg-readonly .cm-def, .cm-s-reeborg-dark .cm-def { color: rgb(153, 255, 153); }

.cm-s-reeborg-readonly .cm-variable-3, .cm-s-reeborg-dark .cm-variable-3 { color: rgb(153, 255, 153); }

.cm-s-reeborg-dark .cm-builtin, .cm-s-reeborg-dark .cm-special, .cm-s-reeborg-readonly .cm-builtin, .cm-s-reeborg-readonly .cm-special { color: rgb(255, 157, 0); }

.cm-s-reeborg-dark .cm-tab::before, .cm-s-reeborg-readonly .cm-tab::before { content: "â¤"; color: red; }

